<!--
  Revit add-in manifest for Autodesk Revit 2025.
  Installation target:
    %PROGRAMDATA%\Autodesk\Revit\Addins\2025\BimTools.SpxExporter.Revit2025.addin
  The matching DLL must sit at:
    %PROGRAMDATA%\Autodesk\Revit\Addins\2025\BimTools.SpxExporter\BimTools.SpxExporter.Revit2025.dll
  (or, for per-user install: %APPDATA%\Autodesk\Revit\Addins\2025\...)
-->
<RevitAddIns>
  <AddIn Type="Application">
    <Name>BIM TOOLS SPX Exporter (Revit 2025)</Name>
    <Assembly>BimTools.SpxExporter\BimTools.SpxExporter.Revit2025.dll</Assembly>
    <AddInId>af3a1c52-8d47-4b0e-9a65-2c7e1d4f8b35</AddInId>
    <FullClassName>BimTools.SpxExporter.Startup.SpxExporterApplication</FullClassName>
    <VendorId>BIMT</VendorId>
    <VendorDescription>BIM TOOLS</VendorDescription>
  </AddIn>
</RevitAddIns>
