    %PROGRAMDATA%\Autodesk\Revit\Addins\2023\BimTools.SpxExporter\BimTools.SpxExporter.Revit2023.dll
  (or, for per-user install: %APPDATA%\Autodesk\Revit\Addins\2023\...)
-->
