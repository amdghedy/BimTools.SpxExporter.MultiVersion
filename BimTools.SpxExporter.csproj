<Project Sdk="Microsoft.NET.Sdk">

	<!-- =========================================================
       BIM TOOLS - SPX EXPORTER
       Revit 2022 - 2026
       Build without requiring Revit installation.

       CLI examples:
       dotnet build -c Release -p:RevitVersion=2024
       dotnet build -c Release -p:RevitVersion=2025

       API DLLs are stored in:
       RevitAPI/R2024/RevitAPI.dll
       RevitAPI/R2024/RevitAPIUI.dll
       ========================================================= -->

	<PropertyGroup>

		<!-- Project configurations -->
		<Configurations>Debug;Release;Release R2022;Release R2023;Release R2024;Release R2025;Release R2026</Configurations>

		<!-- Platform -->
		<Platforms>x64;AnyCPU</Platforms>
		<PlatformTarget>x64</PlatformTarget>

		<!-- Default Revit version -->
		<RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Release R2022'">2022</RevitVersion>
		<RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Release R2023'">2023</RevitVersion>
		<RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Release R2024'">2024</RevitVersion>
		<RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Release R2025'">2025</RevitVersion>
		<RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Release R2026'">2026</RevitVersion>
		<RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>

		<!-- API DLL directory -->
		<RevitApiDir Condition="'$(RevitApiDir)' == ''">$(MSBuildProjectDirectory)\RevitAPI\R$(RevitVersion)\</RevitApiDir>

		<!-- General settings -->
		<RootNamespace>BimTools.SpxExporter</RootNamespace>
		<AssemblyName>BimTools.SpxExporter</AssemblyName>

		<Version>1.5.0</Version>
		<Company>BIM TOOLS</Company>
		<Product>BIM TOOLS SPX Exporter</Product>
		<Copyright>Copyright (c) BIM TOOLS</Copyright>

		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<DebugType>embedded</DebugType>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>

		<LangVersion>10.0</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>

		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>

		<DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>

		<!-- Output -->
		<OutputPath>bin\R$(RevitVersion)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<!-- No automatic Revit deployment -->
		<DeployAfterBuild>false</DeployAfterBuild>

		<!-- Do not copy Revit API assemblies -->
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

	</PropertyGroup>

	<!-- =========================================================
       FRAMEWORK TARGETS
       ========================================================= -->

	<PropertyGroup Condition="'$(RevitVersion)' == '2022' or '$(RevitVersion)' == '2023' or '$(RevitVersion)' == '2024'">

		<TargetFramework>net48</TargetFramework>

	</PropertyGroup>

	<PropertyGroup Condition="'$(RevitVersion)' == '2025' or '$(RevitVersion)' == '2026'">

		<TargetFramework>net8.0-windows</TargetFramework>

	</PropertyGroup>

	<!-- =========================================================
       DEBUG CONFIGURATION
       ========================================================= -->

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">

		<Optimize>false</Optimize>
		<DebugSymbols>true</DebugSymbols>
		<DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>

	</PropertyGroup>

	<!-- =========================================================
       RELEASE CONFIGURATION
       ========================================================= -->

	<PropertyGroup Condition="$(Configuration.StartsWith('Release'))">

		<Optimize>true</Optimize>
		<DebugSymbols>false</DebugSymbols>
		<DefineConstants>$(DefineConstants);TRACE</DefineConstants>

	</PropertyGroup>

	<!-- =========================================================
       PLATFORM CONFIGURATION
       ========================================================= -->

	<PropertyGroup Condition="'$(Platform)' == 'x64'">

		<PlatformTarget>x64</PlatformTarget>

	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'AnyCPU'">

		<PlatformTarget>x64</PlatformTarget>

	</PropertyGroup>

	<!-- =========================================================
       REVIT API REFERENCES
       ========================================================= -->

	<ItemGroup>

		<Reference Include="RevitAPI">
			<HintPath>$(RevitApiDir)RevitAPI.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="RevitAPIUI">
			<HintPath>$(RevitApiDir)RevitAPIUI.dll</HintPath>
			<Private>False</Private>
		</Reference>

	</ItemGroup>

	<!-- =========================================================
       .NET FRAMEWORK REFERENCES
       ========================================================= -->

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">

		<Reference Include="System.Runtime.Serialization" />
		<Reference Include="System.IO.Compression" />
		<Reference Include="System.IO.Compression.FileSystem" />

	</ItemGroup>

	<!-- =========================================================
       ADD-IN MANIFEST
       ========================================================= -->

	<ItemGroup>

		<None Update="BimTools.SpxExporter.addin">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

	</ItemGroup>

	<!-- =========================================================
       BUILD VALIDATION
       ========================================================= -->

	<Target Name="ValidateRevitVersion" BeforeTargets="PrepareForBuild">

		<Error
		  Condition="'$(RevitVersion)' != '2022' and '$(RevitVersion)' != '2023' and '$(RevitVersion)' != '2024' and '$(RevitVersion)' != '2025' and '$(RevitVersion)' != '2026'"
		  Text="Unsupported RevitVersion: $(RevitVersion). Supported versions: 2022, 2023, 2024, 2025, 2026." />

	</Target>

	<Target Name="ValidateRevitApiReferences" BeforeTargets="ResolveReferences">

		<Error
		  Condition="!Exists('$(RevitApiDir)RevitAPI.dll')"
		  Text="RevitAPI.dll not found: $(RevitApiDir)RevitAPI.dll. Check RevitApiDir." />

		<Error
		  Condition="!Exists('$(RevitApiDir)RevitAPIUI.dll')"
		  Text="RevitAPIUI.dll not found: $(RevitApiDir)RevitAPIUI.dll. Check RevitApiDir." />

	</Target>

</Project>
